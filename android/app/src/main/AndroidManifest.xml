<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- AdMob (رفيق بلس): إعلان شريطي محدود لغير المشتركين -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="@string/admob_app_id" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <!-- أيقونة التطبيق في الشاشة الرئيسية: الأصلية مفعّلة، والبديلة (رفيق بلس) يفعّلها AppIconPlugin -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherRoyal"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_royal"
            android:roundIcon="@mipmap/ic_alt_royal_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherNight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_night"
            android:roundIcon="@mipmap/ic_alt_night_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherTurquoise"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_turquoise"
            android:roundIcon="@mipmap/ic_alt_turquoise_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherDawn"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_dawn"
            android:roundIcon="@mipmap/ic_alt_dawn_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherNature"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_nature"
            android:roundIcon="@mipmap/ic_alt_nature_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherViolet"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_violet"
            android:roundIcon="@mipmap/ic_alt_violet_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherRose"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_rose"
            android:roundIcon="@mipmap/ic_alt_rose_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherEvening"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_alt_evening"
            android:roundIcon="@mipmap/ic_alt_evening_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ودجت مواقيت الصلاة -->
        <receiver
            android:name=".PrayerWidgetProvider"
            android:exported="false"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_widget_info" />
        </receiver>
        <receiver
            android:name=".DailyWidgetProvider"
            android:exported="false"
            android:label="@string/daily_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_widget_info" />
        </receiver>

        <receiver
            android:name=".WeatherWidgetProvider"
            android:exported="false"
            android:label="@string/weather_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/weather_widget_info" />
        </receiver>
        <receiver
            android:name=".ProgressWidgetProvider"
            android:exported="false"
            android:label="@string/progress_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/progress_widget_info" />
        </receiver>

        <receiver
            android:name=".ResumeWidgetProvider"
            android:exported="false"
            android:label="@string/resume_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/resume_widget_info" />
        </receiver>

        <receiver
            android:name=".TasbihWidgetProvider"
            android:exported="false"
            android:label="@string/tasbih_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/tasbih_widget_info" />
        </receiver>
        <receiver
            android:name=".RamadanWidgetProvider"
            android:exported="false"
            android:label="@string/ramadan_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ramadan_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Android 11+: إظهار خدمة التعرف على الكلام ونافذة Google الصوتية للتطبيق (البحث بالصوت) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- محرك النطق في النظام (قراءة الأذكار بصوت الجهاز في شاشة تنبيه الأذكار) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- إيجاد شاشة التلفاز في الشبكة المنزلية (التحكم بالتلفاز) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- الموقع التقريبي يكفي لحساب المواقيت والقبلة؛ يُطلب فقط عند ضغط «استخدم موقعي الحالي» -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
</manifest>

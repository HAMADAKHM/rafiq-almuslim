<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت الأذكار (متوسط): عدّاد وشريط تقدم وأزرار -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/a_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:padding="12dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/a_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/extra_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/a_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/a_cat" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#E3C98F" android:textSize="15sp" android:layout_weight="1" android:textStyle="bold" android:maxLines="1" />
            <ImageView android:id="@+id/a_switch" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_circle_line" android:padding="6dp" android:src="@drawable/ic_w_refresh" android:contentDescription="@string/adhkar_switch" />
        </LinearLayout>
        <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/a_text" android:layout_width="match_parent" android:layout_height="0dp" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_weight="1" android:gravity="center" android:fontFamily="serif" android:lineSpacingMultiplier="1.25" android:ellipsize="end" android:maxLines="3" />
        <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/a_src" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CFC6AE" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
        <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/a_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_gravity="center_horizontal" android:textStyle="bold" />
        <ProgressBar android:id="@+id/a_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="2dp" android:max="100" android:progressDrawable="@drawable/widget_progress_gold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:orientation="horizontal">
            <ImageView android:id="@+id/a_next" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/widget_circle_line" android:padding="7dp" android:src="@drawable/ic_w_next" android:rotation="180" android:contentDescription="@string/adhkar_next" />
            <ImageView android:id="@+id/a_inc" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:background="@drawable/widget_circle_gold" android:padding="10dp" android:src="@drawable/ic_w_play" android:rotation="180" android:contentDescription="@string/adhkar_inc" />
            <ImageView android:id="@+id/a_prev" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/widget_circle_line" android:padding="7dp" android:src="@drawable/ic_w_prev" android:rotation="180" android:contentDescription="السابق" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

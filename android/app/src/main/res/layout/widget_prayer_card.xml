<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت «بطاقة الصلاة القادمة»: كقسم الصلاة في الرئيسية — الاسم والوقت والعدّ التنازلي ولوحة المسجد والمدينة، ثم الصلوات الخمس بأيقوناتها والقادمة مذهّبة -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/k_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <TextView android:id="@+id/k_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/k_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_next" android:textColor="#CFC8EC" android:textSize="12sp" />
                <TextView android:id="@+id/k_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/k_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F6C35A" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_left" android:textColor="#E8E4F7" android:textSize="12sp" />
                    <Chronometer android:id="@+id/k_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#F6C35A" android:textSize="15sp" android:textStyle="bold" android:layoutDirection="ltr" />
                </LinearLayout>
            </LinearLayout>
            <ImageView android:layout_width="92dp" android:layout_height="92dp" android:src="@drawable/widget_mosque" android:scaleType="fitCenter" android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/wic_pin" android:alpha="0.75" android:contentDescription="@null" />
            <TextView android:id="@+id/k_city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#CFC8EC" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:background="@drawable/widget_card_panel" android:orientation="horizontal" android:padding="3dp">
            <LinearLayout android:id="@+id/k_cell_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_card_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
                <ImageView android:id="@+id/k_icon_0" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wic_fajr" android:contentDescription="@null" />
                <TextView android:id="@+id/k_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#CFC8EC" android:textSize="12sp" android:maxLines="1" />
                <TextView android:id="@+id/k_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/k_cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_card_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
                <ImageView android:id="@+id/k_icon_1" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wic_dhuhr" android:contentDescription="@null" />
                <TextView android:id="@+id/k_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#CFC8EC" android:textSize="12sp" android:maxLines="1" />
                <TextView android:id="@+id/k_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/k_cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_card_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
                <ImageView android:id="@+id/k_icon_2" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wic_asr" android:contentDescription="@null" />
                <TextView android:id="@+id/k_name_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#CFC8EC" android:textSize="12sp" android:maxLines="1" />
                <TextView android:id="@+id/k_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/k_cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_card_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
                <ImageView android:id="@+id/k_icon_3" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wic_maghrib" android:contentDescription="@null" />
                <TextView android:id="@+id/k_name_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#CFC8EC" android:textSize="12sp" android:maxLines="1" />
                <TextView android:id="@+id/k_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/k_cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_card_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
                <ImageView android:id="@+id/k_icon_4" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wic_isha" android:contentDescription="@null" />
                <TextView android:id="@+id/k_name_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#CFC8EC" android:textSize="12sp" android:maxLines="1" />
                <TextView android:id="@+id/k_time_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

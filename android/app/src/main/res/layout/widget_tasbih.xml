<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت بلس: المسبحة — اضغط للعدّ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:padding="10dp">
    <TextView android:id="@+id/t_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#FFFFFF" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/t_content" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/t_phrase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F0D68F" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/t_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:id="@+id/t_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#D9E6DF" android:textSize="11sp" />
        <TextView android:id="@+id/t_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/widget_cell" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="@string/tasbih_reset" android:textColor="#FFFFFF" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت السبحة (صغير): حلقة المسبحة والعدد -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:padding="8dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/t_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/t_content" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/t_phrase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3C98F" android:textSize="22sp" android:gravity="center" android:fontFamily="serif" android:textStyle="bold" android:maxLines="3" />
            <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/t_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CFC6AE" android:textSize="10sp" android:layout_marginTop="2dp" />
            <ImageView android:id="@+id/t_reset" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginTop="6dp" android:background="@drawable/widget_circle_gold" android:padding="8dp" android:src="@drawable/ic_w_refresh_dark" android:contentDescription="@string/tasbih_reset" />
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/wd_beads" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingBottom="10dp" android:paddingStart="8dp">
                <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/t_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/t_target" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EFE4CC" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

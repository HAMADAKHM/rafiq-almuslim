<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت بتصميم اللوحة المعتمدة: صورة التصميم والنصوص الحية مرسومة معًا (Tile.java)، وفوقها العدّ التنازلي الحي ومناطق الضغط -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"

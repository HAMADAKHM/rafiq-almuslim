<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت الدعاء (متوسط): صورة غروب ولافتة «دعاء اليوم» -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/u_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:padding="12dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/extra_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/u_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/u_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:background="@drawable/widget_pill_green" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="@string/dua_title" android:textColor="#E3C98F" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_text" android:layout_width="match_parent" android:layout_height="0dp" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_weight="1" android:gravity="center" android:fontFamily="serif" android:textStyle="bold" android:lineSpacingMultiplier="1.25" android:ellipsize="end" android:maxLines="3" />
        <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_src" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E9DFC6" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/u_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" >
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wd_logo" android:importantForAccessibility="no" />
            <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="رفيق المسلم" android:textColor="#E3C98F" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:id="@+id/u_next" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/widget_circle_line" android:padding="5dp" android:src="@drawable/ic_w_refresh" android:contentDescription="@string/dua_next" />
            <ImageView android:id="@+id/u_copy" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="6dp" android:background="@drawable/widget_circle_line" android:padding="5dp" android:src="@drawable/ic_w_copy" android:contentDescription="@string/dua_copy" />
            <LinearLayout android:id="@+id/u_share" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/widget_bar_dark" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dua_share" android:textColor="#EFE4CC" android:textSize="12sp" android:textStyle="bold" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="5dp" android:src="@drawable/ic_w_share" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

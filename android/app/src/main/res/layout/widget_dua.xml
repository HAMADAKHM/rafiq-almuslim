<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت دعاء اليوم: الدعاء بمصدره، وأزرار النسخ والمشاركة ودعاء آخر، وخلفية تتبدل كل يوم -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/u_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:layoutDirection="rtl" android:padding="12dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/extra_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/u_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dua_title" android:textColor="#E3C98F" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:lineSpacingMultiplier="1.3" android:ellipsize="end" android:maxLines="5" />
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_src" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#CFC6AE" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/u_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
            <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_copy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/dua_copy" android:textColor="#EFE4CC" android:textSize="12sp" />
            <TextView android:id="@+id/u_share" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="@drawable/widget_pill_gold" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/dua_share" android:textColor="#10221F" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/u_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/dua_next" android:textColor="#EFE4CC" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت «الكل في واحد»: الصلاة القادمة وعدّ تنازلي، ومواقيت اليوم، وآية اليوم، وذكر اليوم، واختصارات الأقسام -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/o_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:layoutDirection="rtl" android:padding="12dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/o_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/o_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_next" android:textColor="#E3C98F" android:textSize="11sp" />
                <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <Chronometer android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layoutDirection="ltr" android:textColor="#E3C98F" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CFC6AE" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/o_times" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/o_c0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp"><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EFE4CC" android:textSize="10sp" android:maxLines="1" /><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" /></LinearLayout>
            <LinearLayout android:id="@+id/o_c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp"><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EFE4CC" android:textSize="10sp" android:maxLines="1" /><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" /></LinearLayout>
            <LinearLayout android:id="@+id/o_c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp"><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EFE4CC" android:textSize="10sp" android:maxLines="1" /><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" /></LinearLayout>
            <LinearLayout android:id="@+id/o_c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp"><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EFE4CC" android:textSize="10sp" android:maxLines="1" /><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" /></LinearLayout>
            <LinearLayout android:id="@+id/o_c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_cell" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp"><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EFE4CC" android:textSize="10sp" android:maxLines="1" /><TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" /></LinearLayout>
        </LinearLayout>
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_ayah" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="15sp" android:lineSpacingMultiplier="1.25" android:ellipsize="end" android:maxLines="3" />
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_ayah_ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E3C98F" android:textSize="10sp" android:maxLines="1" />
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_dhikr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#EFE4CC" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:id="@+id/o_links" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_q" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="القرآن" android:textColor="#EFE4CC" android:textSize="11sp" android:maxLines="1" />
            <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_a" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="الأذكار" android:textColor="#EFE4CC" android:textSize="11sp" android:maxLines="1" />
            <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_k" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="القبلة" android:textColor="#EFE4CC" android:textSize="11sp" android:maxLines="1" />
            <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="المسبحة" android:textColor="#EFE4CC" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

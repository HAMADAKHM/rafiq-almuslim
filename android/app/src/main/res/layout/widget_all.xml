<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت الشامل (كبير): الصلاة القادمة وآية اليوم وذكر اليوم والاختصارات -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/o_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:padding="12dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/o_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/o_top" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" >
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wd_logo" android:importantForAccessibility="no" />
            <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="رفيق المسلم" android:textColor="#E3C98F" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
                <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EFE4CC" android:textSize="13sp" android:layout_marginTop="6dp" android:text="@string/widget_next" />
                <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_w_clock" android:importantForAccessibility="no" />
                    <Chronometer android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:gravity="center" android:orientation="vertical">
                <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_ayah_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3C98F" android:textSize="14sp" android:text="◆ آية اليوم ◆" android:textStyle="bold" />
                <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_ayah" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:gravity="center" android:fontFamily="serif" android:lineSpacingMultiplier="1.25" android:ellipsize="end" android:maxLines="3" />
                <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_ayah_ref" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3C98F" android:textSize="10sp" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_bar_dark" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
            <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/o_dhikr" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_weight="1.2" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <LinearLayout android:id="@+id/o_links" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:orientation="horizontal">
                <LinearLayout android:id="@+id/o_q" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/wd_ic_quran" android:importantForAccessibility="no" />
                    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="القرآن" android:textColor="#EFE4CC" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/o_s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/wd_ic_adhkar" android:importantForAccessibility="no" />
                    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="السبحة" android:textColor="#EFE4CC" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/o_k" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/wd_ic_qibla" android:importantForAccessibility="no" />
                    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="القبلة" android:textColor="#EFE4CC" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/o_a" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/wd_ic_prayer" android:importantForAccessibility="no" />
                    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الصلاة" android:textColor="#EFE4CC" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

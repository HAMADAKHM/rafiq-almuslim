<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت القرآن الكريم (متوسط): ورق عاجي بإطار مزخرف -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:padding="12dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:shadowColor="#AA000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/daily_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/daily_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/daily_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/daily_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:background="@drawable/widget_pill_green" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="قال تعالى:" android:textColor="#E3C98F" android:textSize="13sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="64" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/daily_ayah" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="serif" android:textColor="#1B2F2A" android:textSize="19sp" android:lineSpacingMultiplier="1.3" android:ellipsize="end" android:maxLines="3" />
                <TextView android:id="@+id/daily_ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#5B4A22" android:textSize="12sp" android:maxLines="1" />
                <TextView android:id="@+id/daily_wird" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#4B5A52" android:textSize="11sp" android:maxLines="1" android:visibility="gone" />
                <ProgressBar android:id="@+id/daily_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressDrawable="@drawable/widget_progress_gold" android:visibility="gone" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="36" />
        </LinearLayout>
        <LinearLayout android:id="@+id/daily_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" >
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wd_logo" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="رفيق المسلم" android:textColor="#1B2F2A" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
            <ImageView android:id="@+id/daily_next" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="8dp" android:background="@drawable/widget_circle_line" android:padding="5dp" android:src="@drawable/ic_w_refresh_dark" android:contentDescription="@string/ayah_next" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/daily_resume" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill_green" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_w_book" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/ayah_resume" android:textColor="#EFE4CC" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

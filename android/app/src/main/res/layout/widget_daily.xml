<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت آية اليوم والورد — أخضر زمردي ولمسة ذهبية -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:padding="12dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />

    <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1"
        android:id="@+id/daily_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/daily_empty"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/daily_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/daily_title" android:textColor="#E3C98F" android:textSize="11sp" />
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/daily_ayah" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:textSize="17sp" android:lineSpacingMultiplier="1.25" android:ellipsize="end" android:maxLines="4" />
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/daily_ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E3C98F" android:textSize="12sp" android:maxLines="1" />
        <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/daily_wird" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#EFE4CC" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/daily_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:orientation="horizontal">
            <TextView android:shadowColor="#99000000" android:shadowRadius="3" android:shadowDy="1" android:id="@+id/daily_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/ayah_next" android:textColor="#EFE4CC" android:textSize="12sp" />
            <TextView android:id="@+id/daily_resume" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/widget_pill_gold" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/ayah_resume" android:textColor="#10221F" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/daily_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp" android:max="100" android:progressTint="#C6A15B" android:progressBackgroundTint="#33FFFFFF" />
    </LinearLayout>
</FrameLayout>

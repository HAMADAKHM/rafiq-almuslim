<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الودجت «evening» (تصميم الودجت — رفيق بلس) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="300" android:startColor="#050B17" android:centerColor="#0F1D34" android:endColor="#1D3456" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="24dp" />
            <stroke android:width="1.2dp" android:color="#B3F6C77E" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الودجت «violet» (تصميم الودجت — رفيق بلس) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="300" android:startColor="#140A33" android:centerColor="#2A1660" android:endColor="#4D2E9A" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="24dp" />
            <stroke android:width="1.2dp" android:color="#99E7E9F2" />
        </shape>
    </item>
</layer-list>

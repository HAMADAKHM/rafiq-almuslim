{
  "name": "islamic-companion",
  "private": true,
  "version": "1.0.0-beta.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "data": "node scripts/build-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "cap:sync": "npm run build && npx cap sync",
    "android:open": "npx cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npx cap open ios",
    "build:tv": "vite build --config vite.tv.config.ts && node scripts/tv-index.mjs",
    "tv:assets": "node -e \"const fs=require('fs');fs.rmSync('android-tv/app/src/main/assets/tv',{recursive:true,force:true});fs.mkdirSync('android-tv/app/src/main/assets',{recursive:true});fs.cpSync('dist-tv','android-tv/app/src/main/assets/tv',{recursive:true})\""
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "adhan": "^4.4.6",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "quran-meta": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@photostructure/tz-lookup": "^11.7.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "all-the-cities": "^3.1.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "quran-json": "^3.1.2",
    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "description": "رفيق المسلم — تطبيق إسلامي مجاني بالكامل، صدقة جارية عن روح المرحوم قصي بديع خلفه (أبو محمد)"
}

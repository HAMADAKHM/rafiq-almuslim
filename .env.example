# رفيق المسلم لا يحتاج أي مفتاح API أو سر. هذه متغيرات بناء اختيارية فقط (لا قيم سرية).
# انسخ الملف إلى .env.local عند الحاجة (الملفات *.local متجاهلة في git).

# 1 = توجيه عبر # بدل مسارات الخادم (لنسخة المعاينة المستضافة دون إعداد خادم)
VITE_HASH_ROUTER=0

# 1 = تُضبط تلقائيًا في بناء الملف الواحد (npm run build:standalone)؛ لا تُغيّرها يدويًا
VITE_STANDALONE=0

# مفتاح توقيع النشر في Google Play لا يوضع هنا ولا في المستودع؛ يُضاف في GitHub كـ Secret عند تجهيز النشر.
